{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "hermes *": "allow"
    }
  },
  "agent": {
    "build": {
      "model": "opencode/deepseek-v4-flash-free"
    }
  },
  "mcp": {
    "notion": {
      "type": "local",
      "command": ["npx", "-y", "@notionhq/notion-mcp-server"],
      "env": { "NOTION_TOKEN": "{env:NOTION_TOKEN}" },
      "enabled": false
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"],
      "enabled": true
    }
  }
}
