datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Transaction {
  id                    String        @id @default(cuid())
  type                  String // 'income' | 'expense'
  title                 String?       @db.VarChar(100)
  description           String?       @db.VarChar(255)
  value                 Decimal       @db.Decimal(12, 2)
  date                  DateTime      @db.Date
  category              String
  responsible           String
  installment_number    Int?
  total_installments    Int?
  is_recurring          Boolean       @default(false)
  parent_transaction_id String?
  parent_transaction    Transaction?  @relation("Recurring", fields: [parent_transaction_id], references: [id])
  paid                  Boolean       @default(false)
  userId                String
  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  children              Transaction[] @relation("Recurring")
  created_at            DateTime      @default(now())
  updated_at            DateTime      @updatedAt

  @@index([date])
  @@index([category])
  @@index([type])
  @@index([parent_transaction_id])
  @@index([userId])
  @@map("transactions")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  nickname      String?
  email         String?   @unique
  emailVerified DateTime?
  password      String? // Preenchido se usar Credentials (email/senha)
  aiProfile     String? // Descrição livre do usuário para personalizar o assistente (FING-18)

  // Relacionamentos
  accounts       Account[]
  sessions       Session[]
  transactions   Transaction[] // Relacionamento reverso adicionado
  investments    Investment[]
  goals          Goal[]
  chatSessions   ChatSession[]
  chatMessages   ChatMessage[]
  pendingActions PendingAction[]
  auditLogs      AuditLog[]
  investmentTransactions InvestmentTransaction[]
  categories             Category[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ChatSession {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String?
  summary    String?
  tokenCount Int      @default(0)
  status     String   @default("active") // 'active' | 'archived' (validated in code)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  messages       ChatMessage[]
  pendingActions PendingAction[]

  @@index([userId])
  @@index([userId, status])
  @@map("chat_sessions")
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String // 'user' | 'assistant'
  kind      String      @default("text") // 'text' | 'actions' | 'pick' | 'compacted'
  content   String
  payload   Json?
  tokens    Int?
  compacted Boolean     @default(false)
  createdAt DateTime    @default(now())

  @@index([userId])
  @@index([sessionId, createdAt])
  @@map("chat_messages")
}

model PendingAction {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId  String
  session    ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  queueId    String
  position   Int         @default(0)
  entity     String // 'transaction' | 'investment' | 'category'
  op         String // 'create' | 'update' | 'delete'
  payload    Json
  targetId   String?
  candidates Json?
  before     Json?
  status     String // ActionStatus (validated in code)
  expiresAt  DateTime
  createdAt  DateTime    @default(now())
  resolvedAt DateTime?

  @@index([userId])
  @@index([userId, status])
  @@index([queueId])
  @@index([expiresAt])
  @@map("pending_actions")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  entity    String
  op        String
  entityId  String
  before    Json?
  after     Json?
  source    String   @default("ai-agent")
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity, entityId])
  @@map("audit_logs")
}

model Investment {
  id       String  @id @default(cuid())
  name     String  @db.VarChar(100)
  type     String // 'Renda Fixa' | 'Renda Variável' (validated in Zod, not a DB enum — matches how Transaction.category/type work)
  value    Decimal @db.Decimal(12, 2)
  quantity String? @db.VarChar(100)
  term     String? @db.VarChar(100)

  // Ativo de mercado (opcionais: investimentos manuais legados não têm cotação)
  ticker       String?   @db.VarChar(20)
  market       String?   @db.VarChar(10) // 'BR' | 'US' | 'CRYPTO' | 'FX' | 'OTHER' (validado no Zod)
  currency     String?   @db.VarChar(5)
  purchaseDate DateTime?
  unitPrice    Decimal?  @db.Decimal(18, 6)
  shares       Decimal?  @db.Decimal(18, 6) // posição atual em unidades (quantity segue como texto legado)
  status       String    @default("ACTIVE") @db.VarChar(10) // 'ACTIVE' | 'REDEEMED'

  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  history InvestmentTransaction[]

  @@index([userId])
  @@map("investments")
}

/// Histórico imutável de compras/resgates. Fonte única de verdade (consulta do usuário e RAG).
/// Não gera Transaction. Snapshot do ativo preservado mesmo se o Investment for removido.
model InvestmentTransaction {
  id         String   @id @default(cuid())
  kind       String   @db.VarChar(10) // 'BUY' | 'REDEEM'
  date       DateTime
  quantity   Decimal  @db.Decimal(18, 6)
  unitPrice  Decimal  @db.Decimal(18, 6)
  grossValue Decimal  @db.Decimal(14, 2)
  costBasis  Decimal? @db.Decimal(14, 2) // custo proporcional (resgate)
  profit     Decimal? @db.Decimal(14, 2)
  taxRate    Decimal? @db.Decimal(5, 2)
  taxValue   Decimal? @db.Decimal(14, 2)
  netValue   Decimal? @db.Decimal(14, 2)
  note       String?  @db.VarChar(255)

  // Snapshot do ativo no momento da operação
  assetName   String  @db.VarChar(100)
  assetTicker String? @db.VarChar(20)
  assetMarket String? @db.VarChar(10)
  currency    String? @db.VarChar(5)

  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  investmentId String?
  investment   Investment? @relation(fields: [investmentId], references: [id], onDelete: SetNull)
  created_at   DateTime    @default(now())

  @@index([userId, date])
  @@index([investmentId])
  @@map("investment_transactions")
}

model Goal {
  id            String   @id @default(cuid())
  name          String   @db.VarChar(100)
  targetValue   Decimal  @db.Decimal(12, 2)
  currentValue  Decimal  @default(0) @db.Decimal(12, 2)
  deadlineLabel String?  @db.VarChar(100)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@index([userId])
  @@map("goals")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Catálogo de categorias por usuário. `Transaction.category` guarda o NOME (sem FK nesta fase).
model Category {
  id         String   @id @default(cuid())
  name       String   @db.VarChar(40)
  nameKey    String   @db.VarChar(40) // normalizado (lowercase, sem acento) p/ unicidade
  type       String   @default("both") @db.VarChar(10) // 'income' | 'expense' | 'both' (validado no Zod)
  color      String?  @db.VarChar(9) // hex '#RRGGBB'
  icon       String?  @db.VarChar(40) // chave de ícone (allowlist no Zod)
  isDefault  Boolean  @default(false)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([userId, nameKey])
  @@index([userId])
  @@map("categories")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
