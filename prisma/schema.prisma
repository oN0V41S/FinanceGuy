datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Transaction {
  id                    String        @id @default(cuid())
  type                  String // 'income' | 'expense'
  title                 String?       @db.VarChar(100)
  description           String?       @db.VarChar(255)
  value                 Decimal       @db.Decimal(12, 2)
  date                  DateTime      @db.Date
  category              String
  responsible           String
  installment_number    Int?
  total_installments    Int?
  is_recurring          Boolean       @default(false)
  parent_transaction_id String?
  parent_transaction    Transaction?  @relation("Recurring", fields: [parent_transaction_id], references: [id])
  paid                  Boolean       @default(false)
  userId                String
  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  children              Transaction[] @relation("Recurring")
  created_at            DateTime      @default(now())
  updated_at            DateTime      @updatedAt

  @@index([date])
  @@index([category])
  @@index([type])
  @@index([parent_transaction_id])
  @@index([userId])
  @@map("transactions")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  nickname      String?
  email         String?   @unique
  emailVerified DateTime?
  password      String? // Preenchido se usar Credentials (email/senha)

  // Relacionamentos
  accounts       Account[]
  sessions       Session[]
  transactions   Transaction[] // Relacionamento reverso adicionado
  investments    Investment[]
  goals          Goal[]
  chatSessions   ChatSession[]
  chatMessages   ChatMessage[]
  pendingActions PendingAction[]
  auditLogs      AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ChatSession {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  summary    String?
  tokenCount Int      @default(0)
  status     String   @default("active") // 'active' | 'archived' (validated in code)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  messages       ChatMessage[]
  pendingActions PendingAction[]

  @@index([userId])
  @@index([userId, status])
  @@map("chat_sessions")
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String // 'user' | 'assistant'
  kind      String      @default("text") // 'text' | 'actions' | 'pick' | 'compacted'
  content   String
  payload   Json?
  tokens    Int?
  compacted Boolean     @default(false)
  createdAt DateTime    @default(now())

  @@index([userId])
  @@index([sessionId, createdAt])
  @@map("chat_messages")
}

model PendingAction {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId  String
  session    ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  queueId    String
  position   Int         @default(0)
  entity     String // 'transaction' | 'investment' | 'category'
  op         String // 'create' | 'update' | 'delete'
  payload    Json
  targetId   String?
  candidates Json?
  before     Json?
  status     String // ActionStatus (validated in code)
  expiresAt  DateTime
  createdAt  DateTime    @default(now())
  resolvedAt DateTime?

  @@index([userId])
  @@index([userId, status])
  @@index([queueId])
  @@index([expiresAt])
  @@map("pending_actions")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  entity    String
  op        String
  entityId  String
  before    Json?
  after     Json?
  source    String   @default("ai-agent")
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity, entityId])
  @@map("audit_logs")
}

model Investment {
  id         String   @id @default(cuid())
  name       String   @db.VarChar(100)
  type       String // 'Renda Fixa' | 'Renda Variável' (validated in Zod, not a DB enum — matches how Transaction.category/type work)
  value      Decimal  @db.Decimal(12, 2)
  quantity   String?  @db.VarChar(100)
  term       String?  @db.VarChar(100)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([userId])
  @@map("investments")
}

model Goal {
  id            String   @id @default(cuid())
  name          String   @db.VarChar(100)
  targetValue   Decimal  @db.Decimal(12, 2)
  currentValue  Decimal  @default(0) @db.Decimal(12, 2)
  deadlineLabel String?  @db.VarChar(100)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@index([userId])
  @@map("goals")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
