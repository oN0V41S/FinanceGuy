# Database
DATABASE_URL=postgresql://user:password@localhost:5432/finance_guy

# Authentication
AUTH_SECRET=your_auth_secret_here
JWT_SECRET=your_jwt_secret_here

# Environment
NODE_ENV=development

# Notion MCP (Optional)
NOTION_TOKEN=ntn_your_token_here

# Cache Redis (Upstash) — Issue #9
# Necessário apenas em produção. Sem estas variáveis, o app usa fallback NOOP
# (sem cache) em dev/CI. NUNCA commite valores reais — apenas placeholders.
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url_here
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

# Cache TTL em segundos (opcional — default: 300)
CACHE_TTL=300
