# Database
DATABASE_URL=postgresql://user:password@localhost:5432/finance_guy

# Authentication
AUTH_SECRET=your_auth_secret_here
JWT_SECRET=your_jwt_secret_here

# Environment
NODE_ENV=development

# Cache Redis (Upstash) — Issue #9
# Necessário apenas em produção. Sem estas variáveis, o app usa fallback NOOP
# (sem cache) em dev/CI. NUNCA commite valores reais — apenas placeholders.
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url_here
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

# Cache TTL em segundos (opcional — default: 300)
CACHE_TTL=300

# IA — Assistente (FING-7, Google Gemini)
# Deixe GEMINI_API_KEY vazia para desativar o assistente (a API responde 503 amigavel).
# Coloque o valor real apenas em .env.local / variaveis da Vercel. NUNCA commite chaves.
# PRIVACIDADE/BILLING: no tier gratuito do Gemini API, prompts e respostas podem ser usados
# pelo Google para melhorar produtos. Como titulos de transacoes sao enviados ao modelo,
# em producao use uma chave com billing ativo (tier pago) e defina um teto de gasto.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
AI_REQUEST_TIMEOUT_MS=20000
AI_MAX_OUTPUT_TOKENS=2048
# Rate limit por usuario (Upstash quando configurado; memoria como fallback)
AI_RATE_LIMIT_PER_MINUTE=10
AI_RATE_LIMIT_WINDOW_SECONDS=60
AI_RATE_LIMIT_PER_DAY=50
